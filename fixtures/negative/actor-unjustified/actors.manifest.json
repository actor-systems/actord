{
  "$comment": "Derived from system.ts by `actors graph --write`. Do not edit; `actors check` fails when it is stale.",
  "schemaVersion": 1,
  "system": {
    "name": "minimal",
    "description": "Two actors: a scheduled pinger and a ponger that records pings"
  },
  "actors": [
    {
      "binding": "PINGER",
      "budget": null,
      "effects": [],
      "justification": [
        "scheduling",
        "state"
      ],
      "kind": "deterministic",
      "name": "Pinger",
      "purpose": "Sends a numbered ping on a schedule or on request",
      "receives": [
        "ping.due",
        "ping.kicked"
      ],
      "schedule": {
        "every": "5m",
        "everyMs": 300000,
        "message": "ping.due"
      },
      "sends": [
        "ping.sent"
      ]
    },
    {
      "binding": "PONGER",
      "budget": null,
      "effects": [],
      "justification": [],
      "kind": "deterministic",
      "name": "Ponger",
      "purpose": "Records each ping exactly once",
      "receives": [
        "ping.sent"
      ],
      "schedule": null,
      "sends": []
    }
  ],
  "messages": [
    {
      "description": "The schedule says it's time to ping",
      "name": "ping.due",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "at": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "at"
        ],
        "type": "object"
      },
      "version": 1
    },
    {
      "description": "Someone asked for an immediate ping",
      "name": "ping.kicked",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "version": 1
    },
    {
      "description": "A ping carrying a sequence number",
      "name": "ping.sent",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "note": {
            "type": "string"
          },
          "seq": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "seq"
        ],
        "type": "object"
      },
      "version": 1
    }
  ],
  "routes": [
    {
      "from": "@clock",
      "message": "ping.due",
      "to": "Pinger"
    },
    {
      "from": "@ingress",
      "message": "ping.kicked",
      "to": "Pinger"
    },
    {
      "from": "Pinger",
      "message": "ping.sent",
      "to": "Ponger"
    }
  ],
  "effects": []
}
