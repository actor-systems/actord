      "budget": null,
      "effects": [],
      "justification": [
        "scheduling",
        "state"
      ],
      "kind": "deterministic",
      "name": "Pinger",
      "purpose": "Sends a numbered ping on a schedule or on request",
      "receives": [
        "ping.due",
        "ping.kicked"
      ],
      "schedules": [
        {
          "cron": null,
          "every": "5m",
          "everyMs": 300000,
          "message": "ping.due"
        }
      ],
      "sends": [
        "ping.sent"
      ]
    },
    {
      "binding": "PONGER",
      "budget": null,
      "effects": [],
      "justification": [
        "state"
      ],
      "kind": "deterministic",
      "name": "Ponger",
      "purpose": "Records each ping exactly once",
      "receives": [
        "ping.sent"
      ],
      "schedules": [],
      "sends": [
        "ping.sent"
      ]
    }
  ],
  "messages": [
