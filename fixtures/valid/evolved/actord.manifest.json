          "origin": {
            "type": "string"
          },
          "seq": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "seq",
          "origin"
        ],
        "type": "object"
      },
      "version": 1
    }
  ],
  "routes": [
