            "cron": null,
            "every": "5m",
            "everyMs": 300000,
            "message": "ping.due",
          },
        ],
        "sends": [
          "ping.sent",
        ],
      },
      {
        "binding": "PONGER",
        "budget": null,
        "effects": [],
        "justification": [
          "state",
        ],
        "kind": "deterministic",
        "name": "Ponger",
        "purpose": "Records each ping exactly once",
        "receives": [
          "ping.sent",
        ],
        "schedules": [],
        "sends": [
          "ping.sent",
        ],
      },
    ],
    "effects": [
      {
        "approval": "none",
        "completes": null,
        "deadline": null,
        "description": "Message the operator about a sequence gap",
        "idempotency": "key",
        "kind": "call",
        "name": "notify.operator",
        "probe": null,
        "reconcile": false,
        "result": null,
      },
    ],
    "messages": [
      {
        "description": "The schedule says it's time to ping",
        "name": "ping.due",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "at": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
          },
          "required": [
            "at",
          ],
          "type": "object",
        },
        "version": 1,
      },
      {
        "description": "Someone asked for an immediate ping",
        "name": "ping.kicked",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "reason": {
              "type": "string",
            },
          },
          "required": [
            "reason",
          ],
          "type": "object",
        },
        "version": 1,
      },
      {
        "description": "A ping carrying a sequence number",
        "name": "ping.sent",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "note": {
              "type": "string",
            },
            "origin": {
              "type": "string",
            },
            "seq": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
          },
          "required": [
            "seq",
            "origin",
          ],
          "type": "object",
        },
        "version": 1,
      },
    ],
    "routes": [
      {
        "from": "@clock",
        "message": "ping.due",
        "to": "Pinger",
      },
      {
        "from": "@ingress",
        "message": "ping.kicked",
        "to": "Pinger",
      },
      {
        "from": "Pinger",
        "message": "ping.sent",
        "to": "Ponger",
      },
      {
        "from": "Ponger",
        "message": "ping.sent",
        "to": "Auditor",
      },
    ],
    "schemaVersion": 1,
    "system": {
      "description": "Two actors: a scheduled pinger and a ponger that records pings",
      "name": "minimal",
    },
  },
  "schemaVersion": 1,
  "toolkitVersion": "0.2.0",
  "volatile": [
    "projectRoot",
  ],
  "written": null,
}
`;

exports[`valid fixtures > evolved: check, graph, and diff are deterministic and snapshot-stable > graph 1`] = `
"minimal · 3 actors · 4 routes · 3 messages · 1 effect

Routes
  @clock    ──ping.due@1──▶  Pinger
  @ingress  ──ping.kicked@1──▶  Pinger
  Pinger    ──ping.sent@1──▶  Ponger
  Ponger    ──ping.sent@1──▶  Auditor

Actors
  Auditor (AUDITOR): deterministic · effects notify.operator · justified by isolation, state
    Reports gaps in the ping sequence to an operator
  Pinger (PINGER): deterministic · every 5m · justified by scheduling, state
    Sends a numbered ping on a schedule or on request
  Ponger (PONGER): deterministic · justified by state
    Records each ping exactly once

Effects
  notify.operator: idempotency key, approval none. Message the operator about a sequence gap
"
`;

