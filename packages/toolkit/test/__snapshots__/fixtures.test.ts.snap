    {
      "compatibility": "compatible",
      "detail": "New actor Auditor (deterministic); its namespace is provisioned on the next deploy",
      "irreversible": false,
      "kind": "actor.added",
      "requiresApproval": false,
      "subject": "Auditor",
    },
    {
      "compatibility": "risky",
      "detail": "New external effect notify.operator (idempotency: key); a person must approve the new capability",
      "irreversible": false,
      "kind": "effect.added",
      "requiresApproval": true,
      "subject": "notify.operator",
    },
    {
      "compatibility": "breaking",
      "detail": "payload.origin is a new required property; keep accepting the old shape, or drain before deploying",
      "irreversible": false,
      "kind": "message.payload",
      "requiresApproval": false,
      "subject": "ping.sent",
    },
    {
      "compatibility": "compatible",
      "detail": "New route Ponger → ping.sent → Auditor",
      "irreversible": false,
      "kind": "route.added",
      "requiresApproval": false,
      "subject": "Ponger → ping.sent → Auditor",
    },
  ],
  "command": "diff",
  "head": {
    "system": "minimal",
  },
  "notes": [],
  "plan": [
    {
      "kind": "verify",
      "text": "Run \`actord check\` and \`npm run verify\`; deploy nothing unless both pass.",
    },
    {
      "kind": "config",
      "text": "Declare Auditor in wrangler.jsonc: binding { "name": "AUDITOR", "class_name": "Auditor" } and exports.Auditor = { "type": "durable-object", "storage": "sqlite" } (\`actord check\` confirms both).",
    },
    {
      "kind": "drain",
      "text": "Drain first: ping.sent may refuse copies already in flight. Deploy when outboxes are empty, or avoid the drain: make the new schema accept the old shape too, or add a new message beside the old one and retire the old one in a later deploy. A risky change needs no drain once a test shows old copies still pass.",
    },
    {
      "kind": "approval",
      "text": "A person must approve: New external effect notify.operator (idempotency: key); a person must approve the new capability.",
    },
    {
      "kind": "lifecycle",
      "text": "Durable Object lifecycle changes apply only through \`wrangler deploy\` (not \`wrangler versions upload\`); a later rollback can't cross them, and gradual deployment isn't available for them.",
    },
    {
      "kind": "deploy",
      "text": "Deploying is a person's decision. After approval, they run \`npx wrangler deploy\`; the toolkit never deploys.",
    },
  ],
  "schemaVersion": 1,
  "summary": {
    "breaking": 1,
    "irreversible": false,
    "requiresApproval": true,
    "risky": 1,
    "total": 4,
  },
  "toolkitVersion": "0.2.0",
