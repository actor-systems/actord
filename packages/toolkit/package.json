{
  "name": "@actord/toolkit",
  "version": "0.2.0",
  "description": "Conventions, checks, and inspection for small systems of communicating actors on Cloudflare Durable Objects",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actor-systems/actord.git",
    "directory": "packages/toolkit"
  },
  "homepage": "https://github.com/actor-systems/actord#readme",
  "bugs": {
    "url": "https://github.com/actor-systems/actord/issues"
  },
  "bin": {
    "actord": "./dist/cli.mjs"
  },
  "exports": {
    "./system": {
      "types": "./dist/types/system.d.ts",
      "default": "./dist/system.mjs"
    },
    "./runtime": {
      "types": "./dist/types/runtime/index.d.ts",
      "default": "./dist/runtime.mjs"
    },
    "./sources": {
      "types": "./dist/types/sources/index.d.ts",
      "default": "./dist/sources.mjs"
    },
    "./agents": {
      "types": "./dist/types/agents/index.d.ts",
      "default": "./dist/agents.mjs"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "default": "./dist/testing.mjs"
    },
    "./vitest": {
      "types": "./dist/types/vitest.d.ts",
      "default": "./dist/vitest.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node build.mjs",
    "pretest": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/computer": "0.8.0",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@platformatic/vfs": "0.4.0",
    "@types/node": "24.19.2",
    "agents": "0.30.1",
    "cron-schedule": "6.0.0",
    "esbuild": "0.28.2",
    "postal-mime": "4.1.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@cloudflare/computer": "0.8.0",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@platformatic/vfs": "0.4.0",
    "agents": "~0.30.1",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/computer": {
      "optional": true
    },
    "@earendil-works/chord": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@platformatic/vfs": {
      "optional": true
    },
    "agents": {
      "optional": false
    },
    "zod": {
      "optional": true
    }
  }
}
