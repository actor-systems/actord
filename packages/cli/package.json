{
  "name": "actors-toolkit",
  "version": "0.1.0",
  "description": "Conventions, checks, and inspection for small systems of communicating actors on Cloudflare Durable Objects",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "actors": "./dist/cli.mjs"
  },
  "exports": {
    "./system": {
      "types": "./dist/types/system.d.ts",
      "default": "./dist/system.mjs"
    },
    "./runtime": {
      "types": "./dist/types/runtime/index.d.ts",
      "default": "./dist/runtime.mjs"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "default": "./dist/testing.mjs"
    },
    "./vitest": {
      "types": "./dist/types/vitest.d.ts",
      "default": "./dist/vitest.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
