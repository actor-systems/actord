{
  "modules": [
    "./room.tsx"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/actord",
            "args": [
              "hook",
              "check-on-edit"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/actord",
            "args": [
              "hook",
              "evidence-gate"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
